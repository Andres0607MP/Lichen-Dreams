# ============================================================
# Lichen Dreams — variables de entorno
# Copia este archivo a backend/.env y ajusta los valores reales.
# NO subas backend/.env al repositorio.
# ============================================================

# --- Base de datos (MySQL) -----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=lichen_dreams

# Opcional: URL completa de la base de datos (si se define, tiene prioridad
# sobre el bloque DB_* anterior).
# DATABASE_URL=mysql+pymysql://root:change_me@localhost:3306/lichen_dreams

# --- Seguridad / JWT -----------------------------------------
# OBLIGATORIO: secreto largo y aleatorio para firmar las sesiones.
JWT_SECRET=change_me_genera_un_secreto_largo_aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- Backend ------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# URL publica del backend (para construir URLs de imagenes y recuperacion).
BACKEND_URL=http://127.0.0.1:8000

# --- Google Sign-In / OAuth ----------------------------------
# OBLIGATORIO para usar "Iniciar sesion con Google".
# ID de cliente OAuth (Web) del proyecto en Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Google Maps ---------------------------------------------
# OBLIGATORIO para que el mapa funcione en dispositivo/emulador.
GOOGLE_MAPS_API_KEY=

# --- SMTP (recuperacion de contrasena por correo, opcional) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SMTP_TLS=true

# --- Frontend (solo referencia) ------------------------------
# La URL de la API del frontend Flutter se define en tiempo de compilacion
# con --dart-define=API_BASE_URL=... (no la lee el backend).
# API_BASE_URL=http://127.0.0.1:8000